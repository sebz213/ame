    "lg": { "$value": { "value": 0.75, "unit": "rem" }, "$description": "rounded-xl." },
    "xl": { "$value": { "value": 1, "unit": "rem" }, "$description": "Cards, rows, bubbles (rounded-2xl)." },
    "2xl": { "$value": { "value": 1.5, "unit": "rem" }, "$description": "Popovers and panels (rounded-3xl)." },
    "pill": { "$value": { "value": 999, "unit": "px" }, "$description": "Stadium. Every rounded-full control." }
  },
  "border": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" }, "$description": "Every ring and inset edge." }
